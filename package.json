{
  "name": "app-corrida",
  "private": true,
  "type": "module",
  "description": "App Corrida: monorepo do app (Expo) e dos pacotes internos.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test:unit": "jest --selectProjects unit:pacotes unit:app --coverage",
    "test:integration": "jest --selectProjects integration --passWithNoTests"
  },
  "devDependencies": {
    "@app-corrida/ai-provider": "^0.0.0",
    "@app-corrida/rules-engine": "^0.0.0",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^24.19.2",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
